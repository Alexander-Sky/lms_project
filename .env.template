# Скопируйте файл в .env и подставьте свои значения:
#   cp .env.sample .env
# Значения ниже рассчитаны на запуск через docker compose.

# --- Django ---
SECRET_KEY=your-secret-key
DEBUG=True
# Хосты через запятую. 0.0.0.0 нужен, чтобы сервер отвечал внутри контейнера.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- PostgreSQL ---
# POSTGRES_HOST — имя сервиса из docker-compose.yaml.
# Если запускаете проект без Docker, поставьте localhost.
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Celery и Redis ---
# redis — тоже имя сервиса. Без Docker: redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Stripe ---
# Тестовый ключ из https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_...
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/api/payments/success/
STRIPE_CANCEL_URL=http://127.0.0.1:8000/api/payments/cancel/

# --- Почта ---
# По умолчанию письма печатаются в консоль.
# Для реальной отправки раскомментируйте backend и заполните доступы.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# --- Бизнес-правила ---
# Через сколько дней без входа пользователь блокируется
INACTIVITY_DAYS_LIMIT=30
# Не чаще раза в сколько часов уведомлять подписчиков об обновлении курса
COURSE_UPDATE_NOTIFY_HOURS=4
