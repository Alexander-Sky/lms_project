SECRET_KEY=your-secret-key
DEBUG=True

# Stripe: тестовый ключ из https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_...
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/api/payments/success/
STRIPE_CANCEL_URL=http://127.0.0.1:8000/api/payments/cancel/

# Celery и Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Почта. По умолчанию письма печатаются в консоль.
# Для реальной отправки раскомментируйте backend и заполните доступы.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Бизнес-правила
# Через сколько дней без входа пользователь блокируется
INACTIVITY_DAYS_LIMIT=30
# Не чаще раза в сколько часов уведомлять подписчиков об обновлении курса
COURSE_UPDATE_NOTIFY_HOURS=4
